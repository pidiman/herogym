# App
APP_PORT=8091
SITE_URL=https://hg.pidiman.sk

# Database (PostgreSQL)
DB_NAME=herogym
DB_USER=herogym
DB_PASS=changeme_strong

# API / Admin
JWT_SECRET=changeme_min_32_chars_random_string
# Prvý admin účet: login "admin", heslo "12345".
# Pri prvom prihlásení si ho treba zmeniť a doplniť email.
ADMIN_USER=admin

# Reverse proxy network (Caddy)
PROXY_NETWORK=web

# Shared Adminer network
# The shared Adminer container must also be attached to this Docker network.
ADMINER_NETWORK=db-shared

# SMTP relay (pre password reset emaily)
SMTP_HOST=smtp-relay
SMTP_PORT=25
SMTP_SECURE=false
SMTP_AUTH=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@pidiman.sk
